{
  "name": "opencode-courier",
  "version": "0.1.5",
  "description": "OpenCode V2 plugin: spawn sessions, message them, and wake idle sessions without polling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivopogace/opencode-courier.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "orchestration"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "e2e/run.sh"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-19271"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-19271",
    "@types/bun": "1.3.14",
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  }
}
