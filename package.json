{
  "name": "opencode-courier",
  "version": "0.1.6",
  "description": "An OpenCode V2 plugin that lets one session start other sessions, message them, and be woken by them, without polling.",
  "license": "MIT",
  "author": "Ivo Pogace <71701666+ivopogace@users.noreply.github.com>",
  "homepage": "https://github.com/ivopogace/opencode-courier#readme",
  "bugs": {
    "url": "https://github.com/ivopogace/opencode-courier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivopogace/opencode-courier.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "orchestration"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "e2e/run.sh"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.22"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.22",
    "@types/bun": "1.3.14",
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  }
}
