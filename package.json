{
  "name": "opencode-courier",
  "version": "0.16.2",
  "description": "Multi-session orchestration for OpenCode V2: spawn child sessions, be woken by them. No polling.",
  "license": "MIT",
  "author": "Ivo Pogace <71701666+ivopogace@users.noreply.github.com>",
  "homepage": "https://github.com/ivopogace/opencode-courier#readme",
  "bugs": {
    "url": "https://github.com/ivopogace/opencode-courier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivopogace/opencode-courier.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "orchestration",
    "opencode2",
    "opencode-v2",
    "multi-agent",
    "subagent",
    "subagents",
    "background-agents",
    "parallel",
    "worktree",
    "scheduler",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.tui.json && bun script/build-tui.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "e2e/run.sh"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.3.0",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opencode/theme": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "effect": "4.1.0",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
