exports[`tools courier_subscribe 1`] = `
{
  "description": "Wake a session (this one by default) when a webhook arrives for a topic: a GitHub repository, one of its pull requests or issues (reviews, comments, completed CI runs), or a named generic hook. Each matching delivery arrives as a message, queued behind any running turn. End your turn and wait; do not poll.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "sessionID": {
        "anyOf": [
          {
            "description": "The session to subscribe; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "topic": {
        "description": "owner/repo for every event of a GitHub repository, owner/repo#<number> for one pull request or issue (reviews, comments, completed CI runs), or a plain name for deliveries posted to /hook/<name>.",
        "type": "string",
      },
    },
    "required": [
      "topic",
    ],
    "type": "object",
  },
}
`;

