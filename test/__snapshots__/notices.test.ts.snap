`;

exports[`tools courier_children 1`] = `
{
  "description": "List the sessions this one started with courier_spawn, with each one's state and last reply, and for one started in a group, its group and whether its report is held, still out, or released, e.g. after a compaction or restart. Like courier_status, for a one-off look, not for waiting.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "sessionID": {
        "anyOf": [
          {
            "description": "The session whose children to list; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "type": "object",
  },
}
`;

exports[`tools courier_cleanup 1`] = `
{
  "description": "Remove the git worktree of a session you started with isolate: true, once you have what you need from it, and drop it from courier_children. A worktree with uncommitted changes or commits on no branch is kept and the result lists them; commit or branch what you want, or pass force: true to discard it.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "force": {
        "anyOf": [
          {
            "description": "Remove it even with uncommitted changes or commits on no branch; that work is lost.",
            "type": "boolean",
          },
          {
            "type": "null",
          },
        ],
      },
      "sessionID": {
        "description": "The isolated child whose worktree to remove.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_answer 1`] = `
{
  "description": "Pass on the answer to a permission request or a question that a session you started with courier_spawn (or one started from it) waits on, after a notice from it named the request. The answer is the person's, not yours: first ask the person you are working with, offering the choices the notice lists, then call this with what they chose: reply for a permission request, answers for a question. Never choose for them. The session carries on once it has the answer.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "answers": {
        "anyOf": [
          {
            "description": "For a question: one entry per question, in order, each the label the person chose or the text they gave, or a list of labels where the question allows several.",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
            },
            "type": "array",
          },
          {
            "type": "null",
          },
        ],
      },
      "message": {
        "anyOf": [
          {
            "description": "For a permission request, with reject: the person's reason, passed on with the refusal.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "reply": {
        "anyOf": [
          {
            "description": "For a permission request: the choice the person made, once, always (only when the notice offers it) or reject.",
            "enum": [
              "once",
              "always",
              "reject",
            ],
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "requestID": {
        "description": "The request id from the notice.",
        "type": "string",
      },
      "sessionID": {
        "description": "The session you started that is waiting, as its notice names it.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
      "requestID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_later 1`] = `
{
  "description": "Schedule a message for a session (this one by default), delivered when due and waking it if idle. Use it as a safety net when you start sessions: schedule one check-in, end your turn by replying without calling more tools, and cancel it with courier_cancel if the child reports first. Survives server restarts; may arrive up to ~15 seconds late.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "at": {
        "anyOf": [
          {
            "description": "Deliver at this ISO 8601 time. Give this or delayMinutes.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "delayMinutes": {
        "anyOf": [
          {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                  },
                  {
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN",
                    ],
                    "type": "string",
                  },
                ],
              },
              {
                "type": "string",
              },
            ],
            "description": "Deliver this many minutes from now. Give this or at.",
          },
          {
            "type": "null",
          },
        ],
      },
      "message": {
        "description": "The message to deliver.",
        "type": "string",
      },
      "sessionID": {
        "anyOf": [
          {
            "description": "The session to deliver to; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "required": [
      "message",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_cancel 1`] = `
{
  "description": "Cancel a message scheduled with courier_later, e.g. because the child it was waiting for reported.",
