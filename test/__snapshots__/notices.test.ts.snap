exports[`tools courier_spawn 1`] = `
{
  "description": "Start a new OpenCode session on a task and return immediately. It runs on your model. The session reports back with courier_send, which wakes this session, and you are told if its turn fails instead, it waits for a permission or it asks a question. DO NOT poll it or call courier_status in a loop: once you have started the sessions you need, end your turn by replying without calling more tools; each report starts a new turn in which you carry on. For long tasks, also courier_later a check-in for yourself in case it never reports, and courier_cancel it when it does.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "agent": {
        "anyOf": [
          {
            "description": "Agent to run the session with; defaults to the default agent.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "isolate": {
        "anyOf": [
          {
            "description": "Run the session in its own git worktree so parallel sessions don't share files.",
            "type": "boolean",
          },
          {
            "type": "null",
          },
        ],
      },
      "task": {
        "description": "What the new session should do. It is told who started it and how to report back.",
        "type": "string",
      },
      "title": {
        "anyOf": [
          {
            "description": "Session title; defaults to the task's first line.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "required": [
      "task",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_send 1`] = `
{
  "description": "Deliver a message to another OpenCode session. If that session is idle, OpenCode starts a new turn for it. Use it to report back to the session that started you, or to steer a session you started.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "message": {
        "description": "The message text.",
        "type": "string",
      },
      "queue": {
        "anyOf": [
          {
            "description": "Wait until the target's current turn ends instead of steering it now.",
            "type": "boolean",
          },
          {
            "type": "null",
          },
        ],
      },
      "sessionID": {
        "description": "The session to deliver to.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
      "message",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_status 1`] = `
{
  "description": "Look once at a session's state and its last reply, e.g. on a scheduled check-in. Not for waiting: sessions you started report back on their own.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "sessionID": {
        "description": "The session to look at.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_children 1`] = `
{
  "description": "List the sessions this one started with courier_spawn, with each one's state and last reply, e.g. after a compaction or restart. Like courier_status, for a one-off look, not for waiting.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "sessionID": {
        "anyOf": [
          {
            "description": "The session whose children to list; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "type": "object",
  },
}
`;

exports[`tools courier_cleanup 1`] = `
{
  "description": "Remove the git worktree of a session you started with isolate: true, once you have what you need from it, and drop it from courier_children. A worktree with uncommitted changes or commits on no branch is kept and the result lists them; commit or branch what you want, or pass force: true to discard it.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "force": {
        "anyOf": [
          {
            "description": "Remove it even with uncommitted changes or commits on no branch; that work is lost.",
            "type": "boolean",
          },
          {
            "type": "null",
          },
        ],
      },
      "sessionID": {
        "description": "The isolated child whose worktree to remove.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_answer 1`] = `
{
  "description": "Pass on the answer to a permission request or a question that a session you started with courier_spawn (or one started from it) waits on, after a notice from it named the request. The answer is the person's, not yours: first ask the person you are working with, offering the choices the notice lists, then call this with what they chose: reply for a permission request, answers for a question. Never choose for them. The session carries on once it has the answer.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "answers": {
        "anyOf": [
          {
            "description": "For a question: one entry per question, in order, each the label the person chose or the text they gave, or a list of labels where the question allows several.",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
            },
            "type": "array",
          },
          {
            "type": "null",
          },
        ],
      },
      "message": {
        "anyOf": [
          {
            "description": "For a permission request, with reject: the person's reason, passed on with the refusal.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "reply": {
        "anyOf": [
          {
            "description": "For a permission request: the choice the person made, once, always (only when the notice offers it) or reject.",
            "enum": [
              "once",
              "always",
              "reject",
            ],
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "requestID": {
        "description": "The request id from the notice.",
        "type": "string",
      },
      "sessionID": {
        "description": "The session you started that is waiting, as its notice names it.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
      "requestID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_later 1`] = `
{
  "description": "Schedule a message for a session (this one by default), delivered when due and waking it if idle. Use it as a safety net when you start sessions: schedule one check-in, end your turn by replying without calling more tools, and cancel it with courier_cancel if the child reports first. Survives server restarts; may arrive up to ~15 seconds late.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "at": {
        "anyOf": [
          {
            "description": "Deliver at this ISO 8601 time. Give this or delayMinutes.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "delayMinutes": {
        "anyOf": [
          {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                  },
                  {
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN",
                    ],
                    "type": "string",
                  },
                ],
              },
              {
                "type": "string",
              },
            ],
            "description": "Deliver this many minutes from now. Give this or at.",
          },
          {
            "type": "null",
          },
        ],
      },
      "message": {
        "description": "The message to deliver.",
        "type": "string",
      },
      "sessionID": {
        "anyOf": [
          {
            "description": "The session to deliver to; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "required": [
      "message",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_cancel 1`] = `
{
  "description": "Cancel a message scheduled with courier_later, e.g. because the child it was waiting for reported.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "The id courier_later returned.",
        "type": "string",
      },
    },
    "required": [
      "id",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_subscribe 1`] = `
{
  "description": "Wake a session (this one by default) when a webhook arrives for a topic: a GitHub repository, one of its pull requests or issues (reviews, comments, completed CI runs), or a named generic hook. Each matching delivery arrives as a message, queued behind any running turn. End your turn and wait; do not poll.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "sessionID": {
        "anyOf": [
          {
            "description": "The session to subscribe; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "topic": {
        "description": "owner/repo for every event of a GitHub repository, owner/repo#<number> for one pull request or issue (reviews, comments, completed CI runs), or a plain name for deliveries posted to /hook/<name>.",
        "type": "string",
      },
    },
    "required": [
      "topic",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_unsubscribe 1`] = `
{
  "description": "Stop webhook deliveries for a topic, or all of a session's topics, e.g. once its pull request is merged.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "sessionID": {
        "anyOf": [
          {
            "description": "The session to unsubscribe; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "topic": {
        "anyOf": [
          {
            "description": "The topic to drop; all of this session's when omitted.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "type": "object",
  },
}
`;

