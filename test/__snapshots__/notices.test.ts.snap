          },
          {
            "type": "null",
          },
        ],
      },
    },
    "type": "object",
  },
}
`;

exports[`tools courier_tree 1`] = `
{
  "description": "List the whole tree of sessions under this one (or under sessionID): every session started with courier_spawn from it, directly or through others, each with its depth, what courier_children shows, and whether it still owes a report, sent progress, or ended without one. For a one-off look, not for waiting. A long tree lists at most maxTotal sessions, the live ones first, then the newest, and says how many older ones are left out.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "sessionID": {
        "anyOf": [
          {
            "description": "The session whose subtree to list; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "type": "object",
  },
}
`;

exports[`tools courier_stop 1`] = `
{
  "description": "Stop a session you started, directly or through others, and every session under it: each running turn is interrupted, deepest first, and the messages scheduled for them with courier_later are cancelled. Use it when a subtree went wrong or is no longer needed. They do not report back, and you are not told of what you stopped; a session between you and the target is. A stopped session can be woken again with courier_send. With cleanup: true their worktrees are removed too, unless they hold work that is on no branch.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "cleanup": {
        "anyOf": [
          {
            "description": "Also remove the worktrees of the stopped sessions that ran in one of their own, as courier_cleanup does: one with uncommitted changes or commits on no branch is kept and listed.",
            "type": "boolean",
          },
          {
            "type": "null",
          },
        ],
      },
      "sessionID": {
        "description": "The session to stop, with every session under it. It must have been started, directly or through others, from this one.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_cleanup 1`] = `
{
  "description": "Remove the git worktree of a session you started with isolate: true, once you have what you need from it, and drop it from courier_children. A worktree with uncommitted changes or commits on no branch is kept and the result lists them; commit or branch what you want, or pass force: true to discard it. A session without isolate has no worktree and is only dropped from courier_children. Either way, one in a join group that has not reported is dropped from it, so the group's other reports reach you without it; use this for a member you no longer need a report from. It never deletes the session itself, nor the sessions it started.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "force": {
        "anyOf": [
          {
            "description": "Remove it even with uncommitted changes or commits on no branch; that work is lost.",
            "type": "boolean",
          },
          {
            "type": "null",
          },
        ],
      },
      "sessionID": {
        "description": "The session you started to drop, with its worktree if it is isolated.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_answer 1`] = `
{
  "description": "Pass on the answer to a permission request or a question that a session you started with courier_spawn (or one started from it) waits on, after a notice from it named the request. For a permission request, reply is the answer you propose, once or reject: proposing is not deciding. With once, OpenCode asks the person you are working with in your session, as its own permission prompt for what that session asked, under your permission rules, and the call returns once they have answered; what they allow is passed on, and a refusal with a reason fails this call and is passed on with the reason. Do not ask them in your reply or with your question tool first. For a question, answers is what the person chose: ask them first, with your question tool if you have one, and never answer for them. The session carries on once it has the answer.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "answers": {
        "anyOf": [
          {
            "description": "For a question: one entry per question, in order, each the label the person chose or the text they gave, or a list of labels where the question allows several.",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
            },
            "type": "array",
          },
          {
            "type": "null",
          },
        ],
      },
      "message": {
        "anyOf": [
          {
            "description": "For a permission request, with reject: the reason, passed on with the refusal.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "reply": {
        "anyOf": [
          {
            "description": "For a permission request: the answer you propose, once or reject. With once, OpenCode first asks the person in your session, and it is passed on only once they have allowed it; always is not granted through this tool.",
            "enum": [
              "once",
              "reject",
            ],
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "requestID": {
        "description": "The request id from the notice.",
        "type": "string",
      },
      "sessionID": {
        "description": "The session you started that is waiting, as its notice names it.",
        "type": "string",
      },
    },
    "required": [
      "sessionID",
      "requestID",
    ],
    "type": "object",
  },
}
`;

exports[`tools courier_later 1`] = `
{
  "description": "Schedule a message for a session (this one by default), delivered when due and waking it if idle. Use it as a safety net when you start sessions: schedule one check-in, end your turn by replying without calling more tools, and cancel it with courier_cancel if the child reports first. Survives server restarts; may arrive up to ~15 seconds late.",
  "input": {
    "additionalProperties": false,
    "properties": {
      "at": {
        "anyOf": [
          {
            "description": "Deliver at this ISO 8601 time. Give this or delayMinutes.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "delayMinutes": {
        "anyOf": [
          {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                  },
                  {
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN",
                    ],
                    "type": "string",
                  },
                ],
              },
              {
                "type": "string",
              },
            ],
            "description": "Deliver this many minutes from now. Give this or at.",
          },
          {
            "type": "null",
          },
        ],
      },
      "message": {
        "description": "The message to deliver.",
        "type": "string",
      },
      "sessionID": {
        "anyOf": [
          {
            "description": "The session to deliver to; defaults to this one.",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
    },
    "required": [
      "message",
    ],
    "type": "object",
  },
}
`;

